# Supabase (Lovable Cloud) — public/anon keys, safe to expose
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
VITE_SUPABASE_PROJECT_ID="YOUR-PROJECT-REF"

# Server-side mirrors (used by TanStack Start server functions / SSR)
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
SUPABASE_PROJECT_ID="YOUR-PROJECT-REF"

# Server-only secret — NEVER commit the real value. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=""

# Lovable AI Gateway (only if self-hosting outside Lovable)
LOVABLE_API_KEY=""

# Optional: reCAPTCHA, IndexNow, VAPID push keys, etc. — see src/lib/*.functions.ts

# Akıllı OEM araştırması fallback (varsayılan false)
SMART_OEM_RESEARCH_ENABLED=true
FIRECRAWL_API_KEY=

# ---------------------------------------------------------------
# Self-host (VPS / Docker) — Lovable Cloud kullanırken gerekmez.
# deploy/.env.selfhost olarak kopyalayın (bkz. deploy/README.md).
# ---------------------------------------------------------------
# Uygulamanın dinleyeceği port/host (Docker imajında varsayılan 3000 / 0.0.0.0)
PORT=3000
HOST=0.0.0.0
# Kanonik site adresi (SEO / OAuth redirect / sitemap)
SITE_URL="https://tasitsan.com.tr"

# ---------------------------------------------------------------
# OnlineParça (harici tedarikçi) — self-host ENV fallback.
# Lovable Cloud'da bu bilgiler `suppliers` + `app_secrets` tablolarından okunur.
# Self-host'ta service-role anahtarı yoksa veya DB okuması yapılamıyorsa
# aşağıdaki değişkenler kullanılır. Şifre ASLA repoya yazılmaz.
# ---------------------------------------------------------------
ONLINEPARCA_LOGIN_URL=""
ONLINEPARCA_USERNAME=""
ONLINEPARCA_PASSWORD=""
# Opsiyonel
ONLINEPARCA_SUPPLIER_ID=""        # DB'deki tedarikçi UUID'si (ürün kaydı/sepete ekleme için gerekir)
ONLINEPARCA_SUPPLIER_NAME="OnlineParca"
ONLINEPARCA_MARGIN="0"            # kâr yüzdesi
ONLINEPARCA_MIN_STOCK="1"
ONLINEPARCA_SYSTEM_SELLER_ID=""   # harici ürün kaydı için sistem satıcı UUID'si


# ---------------------------------------------------------------
# Self-host: KENDİ Supabase projeniz
# Örn. https://wulismufjcmddflhlptp.supabase.co
# Sunucu tarafı prefix'siz isimleri okur; yalnız VITE_* verirseniz
# scripts/start-selfhost.mjs bunları otomatik aynalar.
# ---------------------------------------------------------------
# Yönetici (tek sahip) kullanıcı UUID'si — kendi Supabase auth.users kaydınız.
# Değiştirdikten sonra deploy/selfhost-admin-owner.sql dosyasını da çalıştırın.
ADMIN_OWNER_USER_ID=""
VITE_ADMIN_OWNER_USER_ID=""
